# Скопируйте в .env и задайте свои значения.
# Порт игрового сервера.
PORT=3000
# Пароль редактора контента (понадобится на этапе 6).
EDITOR_PASSWORD=придумайте-пароль

# Discord Developer Portal → ваше приложение → OAuth2.
# Client ID и Client Secret. Secret остаётся только на сервере.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Если пусто, адрес возврата берётся из ссылки, по которой открыт сайт.
# В портале: OAuth2 → Redirects. Добавьте оба адреса (туннель меняется при каждом запуске):
#   https://<текущая-ссылка>.trycloudflare.com/api/auth/discord/callback
#   http://localhost:3000/api/auth/discord/callback
DISCORD_REDIRECT_URI=

# Секрет локального scripts/bots.mjs. Боты не попадают в таблицу лидеров.
# Если не задан, используется bunker-local-bots. Поменяйте, если компьютером пользуются другие.
BOT_SECRET=bunker-local-bots
