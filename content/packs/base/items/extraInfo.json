{
  "type": "extraInfo",
  "items": [
    { "title": "В молодости был вожатым в лагере", "source": "original" },
    { "title": "Служил в армии в химических войсках", "source": "author" },
    { "title": "Прошёл курсы первой помощи", "source": "author" },
    { "title": "Знает азбуку Морзе", "source": "author" },
    { "title": "Умеет водить грузовик", "source": "author" },
    { "title": "Имеет лицензию пилота малой авиации", "source": "author" },
    { "title": "Был волонтёром МЧС", "source": "author" },
    { "title": "Пережил кораблекрушение", "source": "author" },
    { "title": "Месяц прожил один в тайге", "source": "author" },
    { "title": "Чемпион района по армрестлингу", "source": "author" },
    { "title": "Знает пять языков", "source": "author" },
    { "title": "Умеет разжигать огонь без спичек", "source": "author" },
    { "title": "Может определить съедобные растения", "source": "author" },
    { "title": "Знает, где спрятан склад с консервами", "source": "author" },
    { "title": "Знает код от бункера соседнего города", "source": "author" },
    { "title": "Брат — генерал", "source": "author" },
    { "title": "Бывший заключённый", "source": "author" },
    { "title": "Находится в федеральном розыске", "source": "author" },
    { "title": "Был сектантом", "source": "author" },
    { "title": "Бывший член банды", "source": "author" },
    { "title": "Клептоман", "source": "author" },
    { "title": "Лунатик", "source": "author" },
    { "title": "Храпит так, что дрожат стены", "source": "author" },
    { "title": "Разговаривает во сне и выдаёт секреты", "source": "author" },
    { "title": "Беременна (или думает, что беременна)", "source": "author" },
    { "title": "Имеет пятерых детей", "source": "author" },
    { "title": "Бесплоден, но скрывает это", "source": "author" },
    { "title": "Аллергия на пыль", "source": "author" },
    { "title": "Аллергия на арахис", "source": "author" },
    { "title": "Вегетарианец и не ест тушёнку", "source": "author" },
    { "title": "Не спит третьи сутки", "source": "author" },
    { "title": "Не моется принципиально", "source": "author" },
    { "title": "Спит по 14 часов в сутки", "source": "author" },
    { "title": "Не умеет плавать", "source": "author" },
    { "title": "Дальтоник", "source": "author" },
    { "title": "Левша", "source": "author" },
    { "title": "Абсолютный музыкальный слух", "source": "author" },
    { "title": "Фотографическая память", "source": "author" },
    { "title": "Может не моргать 10 минут", "source": "author" },
    { "title": "Умеет шевелить ушами", "source": "author" },
    { "title": "Знает все серии «Смешариков» наизусть", "source": "author" },
    { "title": "Каждое утро поёт гимн", "source": "author" },
    { "title": "Верит, что Земля плоская", "source": "author" },
    { "title": "Уверен, что он — реинкарнация Наполеона", "source": "author" },
    { "title": "Предсказал этот катаклизм в своём блоге", "source": "author" },
    { "title": "Видел инопланетян", "source": "author" },
    { "title": "Был ведущим прогноза погоды", "source": "author" },
    { "title": "Снимался в рекламе майонеза", "source": "author" },
    { "title": "Миллионер, но все деньги остались в банке", "source": "author" },
    { "title": "Должен денег всем присутствующим", "source": "author" },
    { "title": "Выиграл в лотерею за день до катаклизма", "source": "author" },
    { "title": "Бывший муж/жена одного из игроков", "source": "author" },
    { "title": "Тайно влюблён в одного из игроков", "source": "author" },
    { "title": "Знает страшный секрет одного из игроков", "source": "author" },
    { "title": "Родственник одного из игроков", "source": "author" },
    { "title": "Однажды спас человека из пожара", "source": "author" },
    { "title": "Однажды случайно поджёг дачу", "source": "author" },
    { "title": "Боится оставаться один и всегда ходит с кем-то", "source": "author" },
    { "title": "Каждые полчаса спрашивает, когда можно выйти", "source": "author" },
    { "title": "Не переносит, когда чавкают", "source": "author" },
    { "title": "Постоянно рассказывает несмешные анекдоты", "source": "author" },
    { "title": "Блогер на 3 подписчика", "source": "author" },
    { "title": "Был чемпионом по поеданию хот-догов", "source": "author" },
    { "title": "Принёс с собой кота, но кот сбежал", "source": "author" },
    { "title": "Умеет готовить вкусно из ничего", "source": "author" },
    { "title": "Умеет чинить всё изолентой", "source": "author" },
    { "title": "Может уговорить кого угодно", "source": "author" },
    { "title": "Всегда говорит правду, даже когда не надо", "source": "author" },
    { "title": "Патологический лжец", "source": "author" },
    { "title": "Скрывает укус неизвестного животного", "source": "author" },
    { "title": "Иммунитет к большинству ядов", "source": "author" },
    { "title": "Донор крови с редкой группой", "source": "author" },
    { "title": "Прошёл программу подготовки космонавтов, но не полетел", "source": "author" },
    { "title": "Капибары его обожают", "source": "author" }
  ]
}
